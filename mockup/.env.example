# ============================================================
# হইচই ডেস্ক — Environment Variables
# Copy to .env (local) and set the SAME values in Vercel →
# Project → Settings → Environment Variables.
# ============================================================

# --- ডাটাবেস ড্রাইভার ---------------------------------------
# turso  -> libSQL (recommended for Vercel, free tier)
# postgres -> local sandbox / Neon (default when unset)
DB_DRIVER=turso

# --- Turso (DB_DRIVER=turso) ---------------------------------
# Dashboard: turso.tech → create database → copy URL + token
TURSO_DATABASE_URL=libsql://YOUR-DB-NAME.turso.io
TURSO_AUTH_TOKEN=

# --- Postgres (DB_DRIVER=postgres) ---------------------------
# Local sandbox / Neon connection string
DATABASE_URL=postgresql://user:pass@host/db

# --- এক-ক্লিক সেটআপ GATE -------------------------------------
# /api/setup-এর জন্য গোপন কী (যেকোনো দীর্ঘ র্যান্ডম স্ট্রিং)
# খালি রাখলে /api/setup পাবলিক হয়ে যায় (শুধু ডেমো!)
SETUP_KEY=

# --- Vercel Cron গার্ড ----------------------------------------
# vercel.json-এর cron এই কী-ই Authorization হিসেবে পাঠায়।
# যেকোনো দীর্ঘ র্যান্ডম স্ট্রিং; খালি রাখলে cron ক্রিয়া সীমাবদ্ধ।
CRON_SECRET=

# --- ফেসবুক / LLM / GitHub (ভল্টে রাখা — এখানে নয়) -----------
# আসল কীগুলো অ্যাডমিন ভল্টে AES-256 এনক্রিপ্টেড থাকে;
# রিপোজিটরিতে কখনো হার্ডকোড করবেন না।
