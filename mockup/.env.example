# Primary database — use a cloud libsql:// URL on Vercel.
DB_DRIVER=turso
TURSO_DATABASE_URL=libsql://YOUR-DB-NAME.turso.io
TURSO_AUTH_TOKEN=

# Local development can use file:./data/hoichoi.db instead.
# Optional Postgres compatibility path (not used by Turso):
# DATABASE_URL=postgresql://user:pass@host/db

# Required for private moderation on Vercel (random, at least 24 characters).
ADMIN_SECRET=

# Only set true if you intentionally want a PUBLIC demonstration workspace.
# DEMO_MODE=true

# Guard the one-time base database setup route.
SETUP_KEY=

# An actual desktop worker uses this token for POST /api/collector/heartbeat.
# Must be at least 24 characters; never expose it as NEXT_PUBLIC_*.
COLLECTOR_SECRET=

# Optional server-side scheduler gate. The current endpoint explicitly skips
# collection; it no longer manufactures successful runs.
CRON_SECRET=
