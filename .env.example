# ---- Database (Turso / libSQL) ----
# Use `file:./hoichoi.db` for local development OR a Turso libsql:// URL.
TURSO_DATABASE_URL=file:./data/hoichoi.db
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJqdGkiOiJIRjh3ZUt0S0VmR1dJZDRqWU9wd3BnIiwib3JnX2lkIjoxMDAwMjM4MzgwfQ.JOea80inIlyH8mym6c26K2_fry1MifXjnh27KMCmWnZKI_MiaKNj5Qg6evrpxHgMW5jRYaUxLXprzHzu6_MwCg

# ---- Public site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin access. Generate with: openssl rand -hex 32
ADMIN_AUTH_SECRET=Mayan@Hoichoi
# Comma-separated admin emails allowed to log in (lowercase).
ADMIN_ALLOWED_EMAILS=admin@hoichoi.db

# ---- Storage adapter ----
# local  -> serve media from the app (dev only, ephemeral on serverless)
# r2     -> Cloudflare R2 (S3-compatible) for production
STORAGE_ADAPTER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
R2_BUCKET_SCREENSHOTS=
R2_PUBLIC_BASE_URL=

# ---- Scraper / pipeline ----
ARCHIVE_VISIBLE_DAYS=7
ARCHIVE_RETENTION_DAYS=30
MAX_SOURCES_PER_RUN=30
MAX_POSTS_PER_RUN=200
SCRAPE_REQUEST_DELAY_MS=2000

# Facebook session cookie (only if using logged-in scraping)
FB_SESSION_COOKIE=

# ---- Multi-AI providers (keys are resolved at runtime) ----
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=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
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# ---- GitHub (push secrets to Actions for the cron mirror) ----
GITHUB_PAT=
GITHUB_REPO=bugsfreeweb/Hoichoi

# ---- Vercel deploy hook (pinged after a successful pipeline run) ----
VERCEL_DEPLOY_HOOK_URL=
