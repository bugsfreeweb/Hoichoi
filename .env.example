# Copy to `.env` and fill in. Local-first defaults work without keys.
# Never commit `.env` (gitignored).

# --- Database (Turso / libSQL) ---
# Local:     file:./data/hoichoi.db
# Production: libsql://<db-name>.<org>.turso.io
TURSO_DATABASE_URL=file:./data/hoichoi.db
# Only needed for a remote libsql:// URL
TURSO_AUTH_TOKEN=

# --- Admin ---
# 32-byte hex for admin sessions: openssl rand -hex 32
ADMIN_AUTH_SECRET=
# Comma-separated admin emails; web admin logs in with desktop-minted one-time codes
ADMIN_ALLOWED_EMAILS=admin@hoichoi.local

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# local filesystem for dev; r2 for production (+ R2_* credentials)
STORAGE_ADAPTER=local

# --- LLM resolver (multi-provider, free tiers) ---
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=

# --- Scraping ---
# Optional c_user/xs cookie for logged-in Facebook scraping
FB_SESSION_COOKIE=

# --- Retention policy ---
ARCHIVE_VISIBLE_DAYS=7
ARCHIVE_RETENTION_DAYS=30