{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoichoi Desk",
  "mainBinaryName": "Hoichoi Desk",
  "version": "1.1.10",
  "identifier": "com.hoichoi.desk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "হৈচৈ ডেস্ক · Hoichoi Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Hoichoi",
    "copyright": "© 2026 Hoichoi",
    "resources": { "resources/runner": "runner" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}