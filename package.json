{
  "name": "hoichoi",
  "version": "1.1.0",
  "private": true,
  "description": "হৈচৈ — Bangla viral-content ephemeral snapshot (auto-curated news desk)",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "scrape": "pnpm --filter scraper scrape",
    "db:migrate": "pnpm --filter db migrate",
    "db:seed": "pnpm --filter db seed",
    "db:demo": "pnpm --filter db demo",
    "db:clean": "pnpm --filter db run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}